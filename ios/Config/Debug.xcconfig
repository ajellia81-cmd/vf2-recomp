# Keep the iOS target interpreter-only. Never remove this without an iOS distribution review.
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) VF2_IOS=1 VF2_DISABLE_JIT=1
CLANG_CXX_LANGUAGE_STANDARD = c++20
HEADER_SEARCH_PATHS = $(inherited) $(SRCROOT)/Generated $(SRCROOT)/../src/core/shim_include $(SRCROOT)/../third_party/rmlui/Include $(SRCROOT)/../third_party/rmlui/Backends
OTHER_CPLUSPLUSFLAGS = $(inherited) -DVF2_IOS=1 -DVF2_DISABLE_JIT=1
OTHER_LDFLAGS = $(inherited) -lz
CLANG_ENABLE_OBJC_ARC = YES
ENABLE_BITCODE = NO
ARCHS = arm64
IPHONEOS_DEPLOYMENT_TARGET = 15.0
ASSETCATALOG_COMPILER_APPICON_NAME =
